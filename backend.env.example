# ===========================================
# Backend Server Configuration
# Copy to backend.env and fill in your values
# ===========================================

# Server
HOST=0.0.0.0
PORT=8080

# TLS certificates
CERT_FILE=../backend/certs/cert.pem
KEY_FILE=../backend/certs/key.pem

# Database
DB_PATH=../data/chat.db

# JWT
# Change this to a strong random secret in production!
JWT_SECRET=change_me_in_production
JWT_TTL=86400

# Call timeout (seconds)
EXPIRE_INTERVAL=5

# TURN server connection info (must match turn.env)
TURN_HOST=localhost
TURN_PORT_PLAIN=3478
TURN_PORT_TLS=5349
TURN_SECRET=turn_shared_secret
TURN_TTL=3600

# Logging (leave empty to log to stdout only)
LOG_FILE=../data/backend.log