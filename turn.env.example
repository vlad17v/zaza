# ===========================================
# TURN Server Configuration
# Copy to turn.env and fill in your values
# ===========================================

# TLS certificates (shared with backend)
CERT_FILE=../backend/certs/cert.pem
KEY_FILE=../backend/certs/key.pem

# TURN auth (must match TURN_SECRET in backend.env)
SHARED_SECRET=turn_shared_secret
REALM=chat.example.com

# Relay address — public IP of this server
# Use 127.0.0.1 for local development
RELAY_ADDR=127.0.0.1

# Relay port range
PORT_MIN=49152
PORT_MAX=65535

# Logging (leave empty to log to stdout only)
LOG_FILE=../data/turn.log