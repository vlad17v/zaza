{
  "description": "REST API для аутентификации",
  "endpoints": {
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "request": {
        "Content-Type": "application/json",
        "body": {
          "userId": "string",
          "password": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "token": "string — JWT",
          "userId": "string"
        }
      },
      "errors": {
        "400": "missing userId or password",
        "401": "invalid credentials"
      }
    },
    "register": {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Только для разработки",
      "request": {
        "body": {
          "userId": "string",
          "password": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ok": true
        }
      },
      "errors": {
        "400": "missing fields",
        "409": "user already exists"
      }
    }
  }
}